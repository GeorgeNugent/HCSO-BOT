<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof branding !== 'undefined' ? branding.dashboardTitle + ' Staff Dashboard' : 'Hendry County Project Staff Dashboard' %></title>
  <link rel="icon" href="/images/hcp-logo.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <% if (page === 'home') { %>
    <link rel="stylesheet" href="/css/dashboard-home.css">
  <% } %>
</head>
<body class="<%= page === 'home' ? 'dashboard-home-page' : '' %>">

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<header class="topbar">
  <button class="hamburger" id="hamburgerBtn" aria-label="Open navigation" aria-expanded="false" aria-controls="mainSidebar">
    <span></span><span></span><span></span>
  </button>

  <div class="topbar-brand">
    <% if (botAvatar) { %>
      <img src="<%= botAvatar %>" alt="Logo" class="topbar-avatar" onerror="this.style.display='none'">
    <% } else { %>
      <div class="topbar-avatar topbar-avatar--placeholder">H</div>
    <% } %>
    <div class="topbar-title-wrap">
      <div class="topbar-title">
        <%= typeof branding !== 'undefined' ? branding.communityName || 'Hendry County Project' : 'Hendry County Project' %>
        <span class="topbar-brand-mark">Staff Dashboard</span>
      </div>
      <div class="topbar-subtitle">Professional staff control center</div>
    </div>
  </div>

  <div class="topbar-actions">
    <span class="btn btn-pill btn-secondary btn-badge">Staff Hub</span>
    <% if (user) { %>
      <div class="topbar-user">
        <% if (user.avatar) { %>
          <img src="<%= user.avatar %>" alt="User" class="topbar-user-avatar" onerror="this.style.display='none'">
        <% } else { %>
          <span class="topbar-user-avatar topbar-user-avatar--placeholder"><%= user.username.charAt(0) %></span>
        <% } %>
        <span class="topbar-username"><%= user.username %></span>
        <a href="/auth/logout" class="btn btn-sm btn-outline">Logout</a>
      </div>
    <% } %>
  </div>
</header>

<div class="layout">
  <aside class="sidebar" id="mainSidebar">
    <nav class="sidebar-nav">
      <div class="sidebar-section-label">Main</div>
      <% if (isBotOwner || !segmentAccess || segmentAccess.home) { %>
        <a href="/" class="nav-link <%= page === 'home' ? 'active' : '' %>">
          <span class="nav-icon">🏠</span>
          <span class="nav-label">Home</span>
        </a>
      <% } %>

      <% var canSeeStaffSection = isBotOwner || (!segmentAccess || segmentAccess.status || segmentAccess.commands || segmentAccess.logs || segmentAccess.settings); %>
      <% if (canSeeStaffSection) { %>
        <div class="sidebar-section-label">Staff</div>
        <% if (isBotOwner || !segmentAccess || segmentAccess.status) { %>
          <a href="/status" class="nav-link <%= page === 'status' ? 'active' : '' %>">
            <span class="nav-icon">📊</span>
            <span class="nav-label">Bot Status</span>
          </a>
        <% } %>
        <% if (isBotOwner || !segmentAccess || segmentAccess.commands) { %>
          <a href="/commands" class="nav-link <%= page === 'commands' ? 'active' : '' %>">
            <span class="nav-icon">⚡</span>
            <span class="nav-label">Commands</span>
          </a>
        <% } %>
        <% if (isBotOwner || !segmentAccess || segmentAccess.logs) { %>
          <a href="/logs" class="nav-link <%= page === 'logs' ? 'active' : '' %>">
            <span class="nav-icon">📋</span>
            <span class="nav-label">Logs</span>
          </a>
        <% } %>
        <% if (isBotOwner || !segmentAccess || segmentAccess.settings) { %>
          <a href="/settings" class="nav-link <%= page === 'settings' ? 'active' : '' %>">
            <span class="nav-icon">⚙️</span>
            <span class="nav-label">Settings</span>
          </a>
        <% } %>
        <% if (isBotOwner) { %>
          <a href="/bot-owner" class="nav-link <%= page === 'bot-owner' ? 'active' : '' %>">
            <span class="nav-icon">👑</span>
            <span class="nav-label">Owner</span>
          </a>
        <% } %>
      <% } %>

    </nav>

    <div class="sidebar-footer">
      <span class="sidebar-footer-text"><%= typeof branding !== 'undefined' ? (branding.fallback.shortName + ' Staff Dashboard') : 'HCP Staff Dashboard' %></span>
    </div>
  </aside>

  <main class="main-content">
