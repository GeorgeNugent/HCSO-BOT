<%- include('partials/header') %>

<div class="hero">
  <div class="hero-content">
    <div class="community-badge">
      <span class="badge-dot"></span>
      FLORIDA FIVEM ROLEPLAY COMMUNITY
    </div>

    <h1>
      <span class="welcome">Welcome to the</span>
      <span class="orange">Hendry County Project</span>
      <span class="staff-panel">Staff Panel</span>
    </h1>

    <div class="hero-line"></div>

    <div class="hero-actions">
      <% if (!segmentAccess || segmentAccess.status) { %>
        <a href="/status" class="hero-button primary">📊 Bot Status</a>
      <% } %>
      <% if (!segmentAccess || segmentAccess.commands) { %>
        <a href="/commands" class="hero-button secondary">⚡ Commands</a>
      <% } %>
      <% if (!segmentAccess || segmentAccess.logs) { %>
        <a href="/logs" class="hero-button secondary">📋 Logs</a>
      <% } %>
      <% if (isBotOwner) { %>
        <a href="/bot-owner" class="hero-button secondary">👑 Owner</a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
