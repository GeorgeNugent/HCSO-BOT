<%- include('partials/header') %>

<div class="page-header">
  <h2 class="page-title">🏠 Overview</h2>
  <p class="page-subtitle">Welcome back, <strong><%= user.username %></strong></p>
</div>

<!-- Stat cards row 1 -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon">🟢</div>
    <div class="stat-body">
      <div class="stat-value"><%= ping %>ms</div>
      <div class="stat-label">API Latency</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">⏱️</div>
    <div class="stat-body">
      <div class="stat-value"><%= uptime %></div>
      <div class="stat-label">Uptime</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">🏘️</div>
    <div class="stat-body">
      <div class="stat-value"><%= guildCount %></div>
      <div class="stat-label">Servers</div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon">👥</div>
    <div class="stat-body">
      <div class="stat-value"><%= memberCount %></div>
      <div class="stat-label">Members</div>
    </div>
  </div>
</div>

<!-- Stat cards row 2 -->
<div class="stats-grid" style="margin-top:12px;">
  <div class="stat-card stat-card--warn">
    <div class="stat-icon">⚖️</div>
    <div class="stat-body">
      <div class="stat-value"><%= totalStrikes %></div>
      <div class="stat-label">Total Strikes</div>
    </div>
  </div>
  <div class="stat-card stat-card--info">
    <div class="stat-icon">🚔</div>
    <div class="stat-body">
      <div class="stat-value"><%= activePatrols %></div>
      <div class="stat-label">Active Patrols</div>
    </div>
  </div>
  <div class="stat-card stat-card--info">
    <div class="stat-icon">🌴</div>
    <div class="stat-body">
      <div class="stat-value"><%= activeLoas %></div>
      <div class="stat-label">Active LOAs</div>
    </div>
  </div>
  <div class="stat-card stat-card--success">
    <div class="stat-icon">📋</div>
    <div class="stat-body">
      <div class="stat-value"><%= openCases %></div>
      <div class="stat-label">Open Cases</div>
    </div>
  </div>
</div>

<!-- Quick actions -->
<div class="section-card" style="margin-top:24px;">
  <h3 class="section-title">Quick Actions</h3>
  <div class="quick-grid">
    <% if (!segmentAccess || segmentAccess.commands) { %>
      <a href="/commands#moderation" class="quick-btn">🔨 Moderation</a>
      <a href="/commands#staffmgmt"  class="quick-btn">🌴 LOA Manager</a>
      <a href="/commands#cases"      class="quick-btn">📋 Cases</a>
      <a href="/commands#announce"   class="quick-btn">📢 Announce</a>
    <% } %>
    <% if (!segmentAccess || segmentAccess.logs) { %>
      <a href="/logs"                class="quick-btn">📜 View Logs</a>
    <% } %>
    <% if (!segmentAccess || segmentAccess.status) { %>
      <a href="/status"              class="quick-btn">📊 Bot Status</a>
    <% } %>
    <% if (isBotOwner) { %>
      <a href="/bot-owner" class="quick-btn">👑 Bot Owner</a>
    <% } %>
  </div>
</div>

<!-- Department quick links -->
<% if ((!segmentAccess || segmentAccess.departments) && typeof departments !== 'undefined' && Object.keys(departments).length > 0) { %>
<div class="section-card" style="margin-top:16px;">
  <h3 class="section-title">🏛️ Departments</h3>
  <div class="quick-grid">
    <a href="/servers" class="quick-btn">🌐 All Servers</a>
    <% var visibleDepartmentIds = Array.isArray(accessibleDepartmentIds) ? accessibleDepartmentIds.map(String) : []; %>
    <% Object.entries(departments).filter(function(entry){ return (entry[1] || {}).type === 'department' && (visibleDepartmentIds.length === 0 || visibleDepartmentIds.includes(String(entry[0]))); }).forEach(function(entry){ var gId = entry[0]; var dept = entry[1]; %>
      <a href="/departments/<%= gId %>" class="quick-btn" style="border-color:<%= dept.color %>44;">
        <%= dept.shortName || dept.name %>
      </a>
    <% }); %>
  </div>
</div>
<% } %>

<!-- Ticket System -->
<% if (typeof ticketCategory !== 'undefined' || typeof ticketTypes !== 'undefined') { %>
<div class="section-card" style="margin-top:20px;">
  <h3 class="section-title">🎫 Ticket System</h3>
  <p class="section-desc">Configure the category that new tickets open under and the buttons shown on the panel.</p>
  <form class="cmd-form" style="max-width:640px;">
    <label for="homeTicketCategoryId">Ticket Category ID</label>
    <input id="homeTicketCategoryId" type="text" value="<%= ticketCategory || '' %>" placeholder="Enter a category ID">

    <label for="homeTicketButtonLabels" style="margin-top:12px;">Ticket Panel Buttons (one per line)</label>
    <textarea id="homeTicketButtonLabels" rows="5" placeholder="Support&#10;Bug Report&#10;Feature Request"><% if (ticketTypes && ticketTypes.length > 0) { %><%= ticketTypes.map(t => t.label).join('\n') %><% } %></textarea>

    <button type="button" class="btn btn-info" onclick="updateHomeTicketSystemSettings()">Save Ticket Settings</button>
    <div id="home-ticket-settings-result" class="inline-result" style="display:none"></div>
  </form>
</div>
<% } %>

<!-- Open tickets summary -->
<% if (openTickets > 0) { %>
<div class="alert alert-info" style="margin-top:16px;">
  📨 There are <strong><%= openTickets %></strong> open ticket(s) currently active.
</div>
<% } %>

<script>
async function updateHomeTicketSystemSettings() {
  const categoryId = document.getElementById("homeTicketCategoryId").value.trim();
  const buttonLabels = document.getElementById("homeTicketButtonLabels").value
    .split(/\r?\n/)
    .map(line => line.trim())
    .filter(Boolean);
  const resultEl = document.getElementById("home-ticket-settings-result");
  resultEl.style.display = "block";
  resultEl.className = "inline-result";
  resultEl.textContent = "Saving...";

  try {
    const r = await fetch("/api/settings/ticket-system", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ categoryId, buttonLabels })
    });
    const d = await r.json();
    if (d.success) {
      resultEl.textContent = "✅ Ticket settings saved!";
      resultEl.classList.add("result-success");
    } else {
      resultEl.textContent = "❌ " + (d.error || "Failed");
      resultEl.classList.add("result-error");
    }
  } catch (e) {
    resultEl.textContent = "❌ Network error";
    resultEl.classList.add("result-error");
  }
}
</script>

<%- include('partials/footer') %>
